                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:text="12/11/2023"
                        android:gravity="end"
                        android:textColor="@color/light_grey1"
                        android:textSize="15dp" />



